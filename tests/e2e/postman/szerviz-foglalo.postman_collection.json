{
  "info": {
    "name": "Szerviz-foglaló API",
    "description": "API tests for the szerviz-foglalo app. Run the whole collection in order (Runner), it creates its own test data.\nSet baseUrl and adminKey in the collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "adminKey",
      "value": "dev-admin-key"
    },
    {
      "key": "oilChangeId",
      "value": ""
    },
    {
      "key": "bookingDate",
      "value": ""
    },
    {
      "key": "slot",
      "value": ""
    },
    {
      "key": "plate",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Szolgáltatások listája",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const services = pm.response.json();",
              "pm.test('Van legalább egy szolgáltatás', () => pm.expect(services).to.be.an('array').that.is.not.empty);",
              "const oil = services.find(s => s.name === 'Olajcsere');",
              "pm.test('Az olajcsere 60 perces', () => pm.expect(oil.durationMinutes).to.eql(60));",
              "pm.collectionVariables.set('oilChangeId', oil.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services"
      }
    },
    {
      "name": "2. Szabad időpontok (3 munkanap múlva)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The 3rd weekday from today, as yyyy-MM-dd.",
              "const d = new Date();",
              "let added = 0;",
              "while (added < 3) {",
              "  d.setDate(d.getDate() + 1);",
              "  if (d.getDay() !== 0 && d.getDay() !== 6) added++;",
              "}",
              "const iso = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
              "pm.collectionVariables.set('bookingDate', iso);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const slots = pm.response.json();",
              "pm.test('Van szabad időpont', () => pm.expect(slots).to.be.an('array').that.is.not.empty);",
              "pm.test('Minden időpont 15 perces lépésközre esik', () => {",
              "  slots.forEach(s => pm.expect([0, 15, 30, 45]).to.include(Number(s.slice(14, 16))));",
              "});",
              "pm.collectionVariables.set('slot', slots[0]);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/availability?serviceTypeId={{oilChangeId}}&date={{bookingDate}}"
      }
    },
    {
      "name": "3. Foglalás létrehozása – 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fresh data on every run: random plate and e-mail address.",
              "const letters = 'ABCDEFGHIJKLMNOPRSTUVZ';",
              "const pick = () => letters[Math.floor(Math.random() * letters.length)];",
              "pm.collectionVariables.set('plate', pick() + pick() + pick() + '-' + (100 + Math.floor(Math.random() * 900)));",
              "pm.collectionVariables.set('customerEmail', 'postman.' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Location fejléc mutat az új foglalásra', () => pm.response.to.have.header('Location'));",
              "const booking = pm.response.json();",
              "pm.test('Állapota: Booked', () => pm.expect(booking.status).to.eql('Booked'));",
              "pm.test('A kezdés a kért időpont', () => pm.expect(booking.startTime).to.eql(pm.collectionVariables.get('slot')));",
              "pm.test('A rendszám hivatalos formában jön vissza', () => pm.expect(booking.licensePlate).to.match(/^[A-Z]{3}-[0-9]{3}$/));",
              "pm.collectionVariables.set('bookingId', booking.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Postman Teszt\",\n  \"customerEmail\": \"{{customerEmail}}\",\n  \"customerPhone\": \"+36 30 123 4567\",\n  \"licensePlate\": \"{{plate}}\",\n  \"serviceTypeId\": {{oilChangeId}},\n  \"startTime\": \"{{slot}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. Hibás adatok – 400 minden hibával",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('Mind a 4 hibát egyszerre visszaadja', () => pm.expect(pm.response.json().errors).to.have.lengthOf(4));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"\",\n  \"customerEmail\": \"nem-email\",\n  \"customerPhone\": \"abc\",\n  \"licensePlate\": \"XX-1\",\n  \"serviceTypeId\": {{oilChangeId}},\n  \"startTime\": \"{{slot}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Admin lista kulcs nélkül – 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "6. Admin lista kulccsal – 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const ids = pm.response.json().map(b => b.id);",
              "pm.test('Benne van az új foglalás', () => pm.expect(ids).to.include(Number(pm.collectionVariables.get('bookingId'))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Admin-Key",
            "value": "{{adminKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings?date={{bookingDate}}"
      }
    },
    {
      "name": "7. Állapot: lépés kihagyása – 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422: foglalt állapotból nem lehet egyből kész', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Admin-Key",
            "value": "{{adminKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Completed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. Állapot: szerelés indítása – 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Állapota: InProgress', () => pm.expect(pm.response.json().status).to.eql('InProgress'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Admin-Key",
            "value": "{{adminKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"InProgress\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "9. Lemondás rossz e-maillel – 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('Nem árulja el, hogy létezik-e a foglalás', () => {",
              "  pm.expect(pm.response.json().errors).to.eql(['Nincs ilyen foglalás ezzel az e-mail címmel.']);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"valaki.mas@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10. Lemondás szerelés közben – 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422: elkezdett munkát nem lehet lemondani', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11. Ismeretlen API cím – 404 JSON",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('JSON-t ad vissza, nem a weboldalt (BUG-001)', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/nincs-ilyen"
      }
    }
  ]
}
